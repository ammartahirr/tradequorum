# TradeQuorum – copy to deployment/.env and fill in. NEVER commit .env.
#
# REQUIRED for any deployment ............ POSTGRES_PASSWORD, JWT_SECRET_KEY, ADMIN_EMAIL, ADMIN_PASSWORD
# REQUIRED for Interactive Brokers ....... TWS_USERID, TWS_PASSWORD (+ BROKER=ibkr, run with --profile ibkr)
# OPTIONAL ............................... AWS (Claude news analysis / SageMaker), news API keys

# =============================================================================
# CORE (required)
# =============================================================================
POSTGRES_PASSWORD=change_me_long_random          # openssl rand -hex 24
JWT_SECRET_KEY=change_me_64_hex_chars            # openssl rand -hex 32
ADMIN_EMAIL=you@example.com                      # seeded on first start
ADMIN_PASSWORD=change_me_strong_password

# Public origin(s) of the dashboard, comma-separated
CORS_ORIGINS=http://localhost,https://your-domain.com

# =============================================================================
# BROKER
# =============================================================================
# paper = built-in simulator (no account needed)
# ibkr  = Interactive Brokers via the ib-gateway container (docker compose --profile ibkr up -d)
BROKER=paper

# IBKR login – use the username of your PAPER account
# (IBKR Portal → Settings → Paper Trading Account; it has its own username/password)
TWS_USERID=
TWS_PASSWORD=
TRADING_MODE=paper                # keep "paper" while testing
IBKR_HOST=ib-gateway
IBKR_PORT=4004                    # inside docker: 4004 = paper, 4003 = live. Local TWS paper = 7497, IB Gateway paper = 4002
IBKR_CLIENT_ID=17
IBKR_ACCOUNT=                     # optional, e.g. DU1234567 (paper ids start with DU)
IBKR_MARKET_DATA_TYPE=3           # 3 = delayed (free), 1 = live (needs market-data subscription)
IBKR_ALLOW_LIVE_TRADING=false     # safety switch – orders are refused on non-paper accounts unless true
# VNC_SERVER_PASSWORD=            # optional: view the gateway UI over VNC (port 5900, keep it private)

# =============================================================================
# MARKET DATA for the training sandbox / technical agent
# =============================================================================
# yahoo     = free, no key (unofficial, delayed; good for testing)
# ibkr      = IB historical data (needs gateway + market-data permissions for stocks;
#             FX/IDEALPRO data is free)
# synthetic = random walk, offline
DEFAULT_DATA_SOURCE=yahoo
TRADING_SYMBOLS=AAPL,MSFT,SPY,EURUSD,BTCUSD

# =============================================================================
# STRATEGY ENGINE
# =============================================================================
# quant   = v2: regime detection + alpha ensemble + ATR/vol risk sizing (recommended)
# classic = v1: news x technical decision matrix
STRATEGY_ENGINE=quant
QUANT_TIMEFRAME=D1
QUANT_HISTORY_BARS=1500
QUANT_EVAL_INTERVAL_MINUTES=60
QUANT_BASE_RISK=0.005             # equity lost if a stop is hit (0.5%)
QUANT_MAX_RISK_PER_TRADE=0.01
QUANT_ALLOW_SHORT=true
QUANT_USE_META_MODEL=false        # turn on only if the sandbox shows OOS AUC > 0.55 for your symbols

# =============================================================================
# RISK LIMITS
# =============================================================================
MAX_POSITION_PCT=0.05
MAX_PORTFOLIO_RISK_PCT=0.02
MAX_CORRELATED_EXPOSURE=0.20
MAX_DAILY_LOSS_PCT=0.05
MAX_OPEN_POSITIONS=10

# =============================================================================
# SCHEDULER
# =============================================================================
ENABLE_SCHEDULER=true
NEWS_SCRAPE_INTERVAL_MINUTES=5
TECHNICAL_ANALYSIS_INTERVAL_MINUTES=5

# =============================================================================
# OPTIONAL – AI news analysis (AWS Bedrock) and ML patterns (SageMaker)
# Without these the news agent falls back to keyword sentiment.
# =============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-opus-4-5-20250514
SAGEMAKER_ENDPOINT=

# =============================================================================
# OPTIONAL – news sources (SEC EDGAR needs no key, just a contact user-agent)
# =============================================================================
SEC_EDGAR_USER_AGENT=TradeQuorum you@example.com
REUTERS_API_KEY=
BLOOMBERG_API_KEY=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_BEARER_TOKEN=

# =============================================================================
# DASHBOARD BUILD (relative URLs work behind the bundled nginx)
# =============================================================================
VITE_API_URL=/api
VITE_WS_URL=/ws
HTTP_PORT=80
HTTPS_PORT=443

LOG_LEVEL=INFO
DEBUG=false
