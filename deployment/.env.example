# AI Trading System - Environment Variables
# Copy this file to .env and fill in your values
# ⚠️  NEVER commit the actual .env file to version control!

# =============================================================================
# DATABASE (PostgreSQL/TimescaleDB)
# =============================================================================
POSTGRES_USER=trading
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=trading
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Full database URL (auto-constructed from above in docker-compose)
# DATABASE_URL=postgresql+asyncpg://trading:your_password@postgres:5432/trading

# Connection pool settings
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# =============================================================================
# REDIS (Caching & Pub/Sub)
# =============================================================================
REDIS_URL=redis://redis:6379/0

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
# Generate a secure key: openssl rand -hex 32
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# =============================================================================
# CORS (Allowed Origins)
# =============================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost

# =============================================================================
# AWS CREDENTIALS (for Bedrock and SageMaker - cross-cloud from GCP)
# =============================================================================
# Create an IAM user with Bedrock and SageMaker access
# https://console.aws.amazon.com/iam/
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=us-east-1

# AWS Bedrock (Claude Opus 4.5 for strategy decisions)
# Model ID for Claude Opus 4.5
BEDROCK_MODEL_ID=anthropic.claude-opus-4-5-20250514

# AWS SageMaker (pattern recognition model endpoint)
# Deploy your model and get the endpoint name from SageMaker console
SAGEMAKER_ENDPOINT=ai-trading-pattern-recognition

# =============================================================================
# EXNESS MT5 TRADING CREDENTIALS
# =============================================================================
# Get these from your Exness account dashboard
# https://my.exness.com/
MT5_LOGIN=12345678
MT5_PASSWORD=your_mt5_password
MT5_SERVER=Exness-MT5Real

# =============================================================================
# NEWS API CREDENTIALS
# =============================================================================

# Reuters API (for financial news)
# Apply at: https://www.reuters.com/info-pages/developer-tools/
REUTERS_API_KEY=your_reuters_api_key

# Bloomberg API (for market news)
# Apply at: https://www.bloomberg.com/professional/support/api-library/
BLOOMBERG_API_KEY=your_bloomberg_api_key

# Twitter/X API (for social sentiment)
# Get from: https://developer.twitter.com/en/portal/dashboard
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# SEC EDGAR (no API key required - public API)
# User agent required by SEC (use your email)
SEC_EDGAR_USER_AGENT=AI-Trading-System your-email@example.com

# =============================================================================
# ALTERNATIVE NEWS APIS (if you don't have Reuters/Bloomberg)
# =============================================================================

# NewsAPI.org (free tier available)
# Get from: https://newsapi.org/register
# NEWSAPI_KEY=your_newsapi_key

# Alpha Vantage (free tier available, includes news)
# Get from: https://www.alphavantage.co/support/#api-key
# ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key

# Finnhub (free tier available)
# Get from: https://finnhub.io/register
# FINNHUB_API_KEY=your_finnhub_key

# Polygon.io (for market data + news)
# Get from: https://polygon.io/dashboard/signup
# POLYGON_API_KEY=your_polygon_key

# =============================================================================
# MARKET DATA APIS (optional - MT5 provides this)
# =============================================================================

# Yahoo Finance (no API key needed, but rate limited)
# YAHOO_FINANCE_ENABLED=true

# Twelve Data (alternative to MT5 for market data)
# Get from: https://twelvedata.com/
# TWELVE_DATA_API_KEY=your_twelve_data_key

# =============================================================================
# RISK MANAGEMENT LIMITS
# =============================================================================
# Maximum position size as percentage of portfolio (0.05 = 5%)
MAX_POSITION_PCT=0.05

# Maximum portfolio risk per trade (0.02 = 2%)
MAX_PORTFOLIO_RISK_PCT=0.02

# Maximum correlated exposure (0.20 = 20%)
MAX_CORRELATED_EXPOSURE=0.20

# Maximum daily loss before trading halt (0.05 = 5%)
MAX_DAILY_LOSS_PCT=0.05

# Maximum number of open positions
MAX_OPEN_POSITIONS=10

# =============================================================================
# TRADING SYMBOLS
# =============================================================================
# Comma-separated list of symbols to trade
TRADING_SYMBOLS=BTCUSD,ETHUSD,XAUUSD,EURUSD,GBPUSD

# =============================================================================
# SCHEDULER INTERVALS
# =============================================================================
# How often to scrape news (in minutes)
NEWS_SCRAPE_INTERVAL_MINUTES=5

# How often to run technical analysis (in minutes)
TECHNICAL_ANALYSIS_INTERVAL_MINUTES=1

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME=AI Trading System
DEBUG=false
LOG_LEVEL=INFO

# =============================================================================
# SSL/TLS (for production - place certs in deployment/nginx/ssl/)
# =============================================================================
# SSL_CERT_PATH=/etc/nginx/ssl/fullchain.pem
# SSL_KEY_PATH=/etc/nginx/ssl/privkey.pem

# =============================================================================
# ENCRYPTION KEY (for encrypting secrets in database)
# =============================================================================
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your_32_byte_hex_encryption_key

# =============================================================================
# ADMIN USER (created on first startup)
# =============================================================================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_secure_password
