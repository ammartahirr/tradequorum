# AI Trading Dashboard - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# API CONFIGURATION
# =============================================================================

# Backend API URL (REST endpoints)
# For local development with Docker Compose:
VITE_API_URL=http://localhost/api

# For direct backend access (without nginx):
# VITE_API_URL=http://localhost:8000/api

# For production (replace with your domain):
# VITE_API_URL=https://your-domain.com/api

# =============================================================================
# WEBSOCKET CONFIGURATION
# =============================================================================

# WebSocket URL for real-time updates
# For local development with Docker Compose:
VITE_WS_URL=ws://localhost/ws

# For direct backend access (without nginx):
# VITE_WS_URL=ws://localhost:8000/ws

# For production with SSL:
# VITE_WS_URL=wss://your-domain.com/ws

# =============================================================================
# FEATURE FLAGS (optional)
# =============================================================================

# Enable/disable features
# VITE_ENABLE_DARK_MODE=true
# VITE_ENABLE_NOTIFICATIONS=true
# VITE_ENABLE_SOUND_ALERTS=false

# =============================================================================
# UI CONFIGURATION (optional)
# =============================================================================

# Refresh intervals (in milliseconds)
# VITE_POSITIONS_REFRESH_INTERVAL=5000
# VITE_SIGNALS_REFRESH_INTERVAL=10000
# VITE_METRICS_REFRESH_INTERVAL=30000

# =============================================================================
# DEBUG
# =============================================================================

# Enable debug mode for development
# VITE_DEBUG=false
